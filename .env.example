# reconguru-mcp configuration — copy to ".env" and edit.
#
#   cp .env.example .env
#
# ".env" is git-ignored, so your API keys stay out of the repo. Every variable
# is optional: leave a line commented (or blank) to use the built-in default.
# All variables are namespaced with RECONGURU_ so they won't collide with other
# tools in your environment.
#
# When running in Docker, pass this file through:
#   docker run -i --rm --env-file .env -v reconguru-workspace:/workspace reconguru-mcp:latest
# When running under a harness, put the same vars in the MCP client config's
# "env" block.

# ─── Transport ───────────────────────────────────────────────────────────
# "stdio" (default, harness launches the process) or "http" (shared/remote).
# RECONGURU_TRANSPORT=stdio

# ─── Sandbox runner ──────────────────────────────────────────────────────
# Default per-tool-call timeout in seconds. Heavy tools (nuclei, ffuf, …) use
# larger built-in budgets; override any tool with RECONGURU_TIMEOUT_<TOOL>.
# RECONGURU_DEFAULT_TIMEOUT_S=300
# RECONGURU_TIMEOUT_NUCLEI=1800
# RECONGURU_TIMEOUT_FFUF=900
# Max characters of tool stdout+stderr returned to the harness (bulk data is
# written to the workspace instead, so this just caps the summary envelope).
# RECONGURU_MAX_OUTPUT_CHARS=100000

# ─── Politeness / concurrency ────────────────────────────────────────────
# RECONGURU_MAX_CONCURRENCY=20
# RECONGURU_RATE_LIMIT_MS=0
# RECONGURU_STEALTH=false
# RECONGURU_USER_AGENT=reconguru-mcp/0.1 (+authorized-testing)

# ─── Authenticated recon ─────────────────────────────────────────────────
# A session you captured by logging in yourself (the toolkit never logs in).
# One or more raw HTTP header lines; HTTP tools inject them. Never logged.
# A tool's per-call `auth` argument overrides this global value.
# RECONGURU_AUTH_HEADER=Cookie: session=abc123
# RECONGURU_AUTH_HEADER=Authorization: Bearer eyJhbGciOi...

# ─── Workspace ───────────────────────────────────────────────────────────
# Where tools read/write shared data (matches the Docker volume mount point).
# RECONGURU_WORKSPACE_DIR=/workspace

# ─── Wordlists (paths inside the image or on the host) ───────────────────
# RECONGURU_DNS_WORDLIST=/opt/seclists/Discovery/DNS/subdomains-top1million-5000.txt
# RECONGURU_CONTENT_WORDLIST=/opt/seclists/Discovery/Web-Content/common.txt

# ─── nuclei ──────────────────────────────────────────────────────────────
# RECONGURU_NUCLEI_SEVERITY=medium,high,critical    # blank = all severities
# RECONGURU_NUCLEI_TEMPLATES=                        # blank = built-in templates

# ─── Optional API keys (blank = that data source is skipped) ─────────────
# RECONGURU_SHODAN_API_KEY=
# RECONGURU_VIRUSTOTAL_API_KEY=
# RECONGURU_SECURITYTRAILS_API_KEY=
# RECONGURU_URLSCAN_API_KEY=
# RECONGURU_CENSYS_API_ID=
# RECONGURU_CENSYS_API_SECRET=
# RECONGURU_GITHUB_TOKEN=
# RECONGURU_CHAOS_API_KEY=
# RECONGURU_NVD_API_KEY=        # https://nvd.nist.gov/developers/request-an-api-key (lifts CVE lookup rate limits)
